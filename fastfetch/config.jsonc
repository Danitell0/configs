// Same skull + info list as the old neofetch setup
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/skull.txt",
    "color": { "1": "red" },
    "padding": { "right": 2 }
  },
  "display": { "separator": ": ", "color": { "keys": "red" } },
  "modules": [
    "title",
    "separator",
    { "type": "os", "key": "OS" },
    { "type": "host", "key": "Host" },
    { "type": "kernel", "key": "Kernel" },
    { "type": "uptime", "key": "Uptime" },
    { "type": "packages", "key": "Packages" },
    { "type": "shell", "key": "Shell" },
    { "type": "display", "key": "Resolution" },
    { "type": "de", "key": "DE" },
    { "type": "wm", "key": "WM" },
    { "type": "wmtheme", "key": "WM Theme" },
    { "type": "theme", "key": "Theme" },
    { "type": "icons", "key": "Icons" },
    { "type": "terminal", "key": "Terminal" },
    { "type": "terminalfont", "key": "Terminal Font" },
    { "type": "cpu", "key": "CPU" },
    { "type": "gpu", "key": "GPU", "driverSpecific": true },
    { "type": "memory", "key": "Memory" },
    "break",
    "colors"
  ]
}
